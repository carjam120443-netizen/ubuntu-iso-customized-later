# Core packages for the custom Ubuntu live image
# Keep this list to packages available in Ubuntu 24.04 (Noble).
# One package per line.

# Boot and live-system support
linux-image-generic
initramfs-tools
live-boot
live-config

# Syslinux live-build support
syslinux
syslinux-common
librsvg2-bin

# Development and Git tools
git
curl
wget

# System monitoring and utilities
htop
neofetch
net-tools

# Archive utilities
zip
unzip
